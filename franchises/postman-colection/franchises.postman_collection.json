			"name": "crear franquicias",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Verifica si la solicitud fue exitosa (código 201 Created o 200 OK)\r",
							"pm.test(\"Status code is 201 or 200\", function () {\r",
							"    pm.response.to.have.status([200, 201]);\r",
							"});\r",
							"\r",
							"// 1. Parsear el cuerpo de la respuesta (Response Body) como JSON\r",
							"var responseJson = pm.response.json();\r",
							"\r",
							"// 2. Extraer el ID de la entidad (Asegúrate que la propiedad sea la correcta, ej: 'id', 'franchiseId', etc.)\r",
							"// Asumo que tu respuesta JSON tiene una propiedad llamada 'id'\r",
							"var newFranchiseId = responseJson.id; \r",
							"\r",
							"// 3. Verificar si el ID existe\r",
							"pm.test(\"Response body includes a Franchise ID\", function () {\r",
							"    pm.expect(newFranchiseId).to.be.a('string').and.to.have.lengthOf.at.least(1);\r",
							"});\r",
							"\r",
							"// 4. Guardar el ID extraído en la variable de entorno 'franchiseId'\r",
							"// Esto lo hace disponible para todas las demás peticiones en este entorno.\r",
							"pm.environment.set(\"franchiseId\", newFranchiseId);\r",
							"\r",
							"console.log(\"-> Franchise ID guardado: \" + newFranchiseId);"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
